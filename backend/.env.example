# Server
PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payroll_db
# Local Docker Postgres doesn't speak SSL — turn it off for local dev.
# Leave this unset (or "true") when DATABASE_URL points at a managed
# provider like Supabase/Neon/RDS, which require SSL.
DATABASE_SSL=false

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h
